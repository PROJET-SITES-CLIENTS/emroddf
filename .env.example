# ══ BASE DE DONNÉES (Neon PostgreSQL) — obligatoire ══
# Connexion fournie par Neon (postgresql://user:pass@host/dbname?sslmode=require)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ══ STOCKAGE MÉDIAS (Vercel Blob) — obligatoire ══
# Token créé dans Vercel → Storage → Blob (vercel_blob_rw_...)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ══ TABLEAU DE BORD /admin — obligatoire ══
ADMIN_EMAIL="admin@emroddf.com"
ADMIN_PASSWORD="choisir-un-mot-de-passe-solide"
# Secret de signature des sessions : chaîne aléatoire longue (ex: openssl rand -hex 32)
ADMIN_SESSION_SECRET="chaine-aleatoire-tres-longue"

# ══ PAIEMENT DJOMY — inchangé ══
DJOMY_CLIENT_ID="..."
DJOMY_CLIENT_SECRET="..."
DJOMY_PARTNER_DOMAIN="..."
# URL publique du site (redirections succès/annulation du paiement)
VITE_PUBLIC_URL="https://emrod.vercel.app"

# ══ NOTIFICATIONS EMAIL (SMTP) — optionnel ══
# Alternative à la configuration dans Tableau de bord → Paramètres → Notifications
# Exemple Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, mot de passe d'application
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL=""
